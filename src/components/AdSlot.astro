---
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle';
  className?: string;
}

const { slotId = 'default', format = 'horizontal', className = '' } = Astro.props;
---

<div class={`w-full my-6 flex flex-col items-center justify-center ${className}`}>
  <!-- Reserved space for AdSense to prevent Cumulative Layout Shift (CLS) -->
  <div
    class={`w-full max-w-4xl rounded-xl border border-slate-200/60 bg-gradient-to-r from-slate-50 via-rose-50/20 to-slate-50 flex items-center justify-center text-center p-3 text-xs text-slate-400 select-none overflow-hidden ${
      format === 'horizontal' ? 'min-h-[90px]' : 'min-h-[250px]'
    }`}
  >
    {/* When Google AdSense is approved, insert <ins class="adsbygoogle" ...></ins> here */}
    <div class="space-y-1">
      <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400/80 block">
        Advertisement / Sponsored
      </span>
      <p class="text-[11px] text-slate-400 font-medium">
        FreeMarriageBiodataMaker.com is 100% free and supported by non-intrusive sponsor ads.
      </p>
    </div>
  </div>
</div>
