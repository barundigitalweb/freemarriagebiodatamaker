---
// Header for FreeMarriageBiodataMaker.com (Clean Responsive Layout)
---

<header class="no-print sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-rose-100 shadow-xs w-full max-w-full">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-20 gap-2 sm:gap-4">
      {/* Brand Logo */}
      <a href="/" class="flex items-center gap-2 group min-w-0">
        <div class="w-8 h-8 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-tr from-rose-800 to-amber-600 flex items-center justify-center text-white shadow-md shadow-rose-900/20 group-hover:scale-105 transition-transform font-serif font-black text-base sm:text-xl shrink-0">
          💍
        </div>
        <div class="min-w-0">
          <span class="text-[15px] min-[360px]:text-lg sm:text-2xl font-black text-slate-900 tracking-tight font-serif block leading-none truncate">
            FreeMarriage<span class="text-rose-700">Biodata</span>
          </span>
          <p class="text-[11px] font-semibold text-slate-400 mt-1 hidden sm:block leading-none">
            Online Matrimonial Biodata & PDF Maker
          </p>
        </div>
      </a>

      {/* Navigation Links (Desktop: lg screens and up) */}
      <nav class="hidden lg:flex items-center gap-1.5 text-sm font-semibold text-slate-600">
        <a href="/hindu-marriage-biodata-format" class="px-3 py-2 rounded-lg hover:text-rose-700 hover:bg-rose-50 transition">
          Hindu Format
        </a>
        <a href="/marathi-marriage-biodata-format" class="px-3 py-2 rounded-lg hover:text-rose-700 hover:bg-rose-50 transition">
          मराठी बायोडाटा
        </a>
        <a href="/bengali-marriage-biodata-format" class="px-3 py-2 rounded-lg hover:text-rose-700 hover:bg-rose-50 transition">
          বাংলা বায়োডাটা
        </a>
        <a href="/biodata-format-for-marriage" class="px-3 py-2 rounded-lg hover:text-rose-700 hover:bg-rose-50 transition">
          Format Guide
        </a>
      </nav>

      {/* Right Action */}
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <div class="hidden xl:flex items-center gap-2 bg-emerald-50 px-3 py-1.5 rounded-full text-xs font-semibold text-emerald-800 border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>No Watermark • 100% Free</span>
        </div>
        <a
          href="/#builder"
          class="inline-flex items-center gap-1 bg-rose-700 hover:bg-rose-800 text-white text-xs sm:text-sm font-bold px-2.5 py-1.5 sm:px-4 sm:py-2.5 rounded-xl transition shadow-sm hover:shadow shrink-0"
        >
          <span>Create</span>
          <span class="hidden min-[380px]:inline">Free</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>

  {/* Mobile & Tablet Sub-Navigation Pills (visible on screens below lg) */}
  <div class="lg:hidden flex items-center gap-2 overflow-x-auto py-2 px-3 border-t border-slate-100 text-xs font-semibold text-slate-700 bg-slate-50/95 no-scrollbar max-w-full">
    <a href="/hindu-marriage-biodata-format" class="whitespace-nowrap px-3 py-1.5 rounded-full bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-700 transition shrink-0 shadow-2xs">
      Hindu Format
    </a>
    <a href="/marathi-marriage-biodata-format" class="whitespace-nowrap px-3 py-1.5 rounded-full bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-700 transition shrink-0 shadow-2xs">
      मराठी बायोडाटा
    </a>
    <a href="/bengali-marriage-biodata-format" class="whitespace-nowrap px-3 py-1.5 rounded-full bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-700 transition shrink-0 shadow-2xs">
      বাংলা বায়োডাটা
    </a>
    <a href="/biodata-format-for-marriage" class="whitespace-nowrap px-3 py-1.5 rounded-full bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-700 transition shrink-0 shadow-2xs">
      Format Guide
    </a>
  </div>
</header>
