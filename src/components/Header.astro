---
// Header for FreeMarriageBiodataMaker.com
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-rose-100 shadow-xs">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 sm:h-20 gap-2">
      {/* Brand Logo */}
      <a href="/" class="flex items-center gap-2 group min-w-0">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-rose-800 to-amber-600 flex items-center justify-center text-white shadow-md shadow-rose-900/20 group-hover:scale-105 transition-transform font-serif font-black text-base sm:text-xl shrink-0">
          💍
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="text-base sm:text-2xl font-black text-slate-900 tracking-tight font-serif whitespace-nowrap">
              FreeMarriage<span class="text-rose-700">Biodata</span>
            </span>
            <span class="hidden sm:inline-block text-[10px] bg-rose-100 text-rose-800 font-bold px-1.5 py-0.5 rounded uppercase shrink-0">
              100% Free
            </span>
          </div>
          <p class="text-[11px] font-semibold text-slate-400 -mt-1 hidden sm:block">
            Online Matrimonial Biodata & PDF Maker
          </p>
        </div>
      </a>

      {/* Navigation Links (Desktop) */}
      <nav class="hidden md:flex items-center gap-1 text-sm font-semibold text-slate-600">
        <a href="/" class="px-3 py-2 rounded-lg hover:text-rose-700 hover:bg-rose-50 transition">
          বায়োডাটা তৈরি করুন
        </a>
        <a href="/bengali-marriage-biodata-maker" class="px-3 py-2 rounded-lg hover:text-rose-700 hover:bg-rose-50 transition">
          বাংলা বায়োডাটা
        </a>
        <a href="/marathi-marriage-biodata-maker" class="px-3 py-2 rounded-lg hover:text-rose-700 hover:bg-rose-50 transition">
          मराठी बायोडाटा
        </a>
        <a href="/hindu-marriage-biodata-format" class="px-3 py-2 rounded-lg hover:text-rose-700 hover:bg-rose-50 transition">
          হিন্দু ফরম্যাট
        </a>
        <a href="/muslim-marriage-biodata-format" class="px-3 py-2 rounded-lg hover:text-rose-700 hover:bg-rose-50 transition">
          মুসলিম ফরম্যাট
        </a>
      </nav>

      {/* Right Action */}
      <div class="flex items-center gap-2 shrink-0">
        <div class="hidden lg:flex items-center gap-2 bg-emerald-50 px-3 py-1.5 rounded-full text-xs font-semibold text-emerald-800 border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>নো ওয়াটারমার্ক • নো লগইন</span>
        </div>
        <a
          href="/#builder"
          class="inline-flex items-center gap-1 bg-rose-700 hover:bg-rose-800 text-white text-xs sm:text-sm font-bold px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl transition shadow-sm hover:shadow shrink-0"
        >
          <span>তৈরি করুন</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>

  {/* Mobile Sub-Navigation Pills for Instant Format Switching */}
  <div class="md:hidden flex items-center gap-2 overflow-x-auto py-2 px-3 border-t border-slate-100 text-xs font-semibold text-slate-700 bg-slate-50/90 no-scrollbar">
    <a href="/bengali-marriage-biodata-maker" class="whitespace-nowrap px-2.5 py-1 rounded-full bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-700 transition shrink-0">
      বাংলা বায়োডাটা
    </a>
    <a href="/marathi-marriage-biodata-maker" class="whitespace-nowrap px-2.5 py-1 rounded-full bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-700 transition shrink-0">
      मराठी बायोडाटा
    </a>
    <a href="/hindu-marriage-biodata-format" class="whitespace-nowrap px-2.5 py-1 rounded-full bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-700 transition shrink-0">
      হিন্দু ফরম্যাট
    </a>
    <a href="/muslim-marriage-biodata-format" class="whitespace-nowrap px-2.5 py-1 rounded-full bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-700 transition shrink-0">
      মুসলিম নিকাহ
    </a>
    <a href="/biodata-format-for-marriage" class="whitespace-nowrap px-2.5 py-1 rounded-full bg-white border border-slate-200 hover:border-rose-400 hover:text-rose-700 transition shrink-0">
      বায়োডাটা গাইড
    </a>
  </div>
</header>
