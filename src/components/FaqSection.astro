---
// FAQ Section with JSON-LD Schema (Multilingual Pan-India Support)
interface Props {
  lang?: 'en' | 'bn';
}

const { lang = 'en' } = Astro.props;

const faqsEn = [
  {
    q: 'Is this marriage biodata maker really 100% free to download?',
    a: 'Yes, absolutely! FreeMarriageBiodataMaker.com is 100% free for life. Unlike other platforms that ask for ₹99–₹149 payment at the download step, we never charge you a single rupee.'
  },
  {
    q: 'Will there be any watermark on my downloaded PDF or image?',
    a: 'No. There are zero watermarks. Your biodata is completely clean, elegant, and professional, ready to share with prospective families and matchmakers without embarrassment.'
  },
  {
    q: 'Are my uploaded photo and private contact details safe?',
    a: '100% Safe. Our application works entirely in your browser (Client-Side). Your photos, phone numbers, and family information are never uploaded, stored, or processed on any remote server.'
  },
  {
    q: 'Which format is best for sending over WhatsApp?',
    a: 'For WhatsApp sharing, click the "WhatsApp Image (HD)" button for a high-resolution, instant-view image, or use "Download PDF" to send as a print-ready document.'
  },
  {
    q: 'What essential details should be included in a matrimonial biodata?',
    a: 'Personal details (name, date & time of birth, height, complexion), education & profession (degree, job title, company, salary), family background (parents’ occupations, siblings), contact information, and optional horoscope details (Gotra, Rashi, Manglik status).'
  }
];

const faqsBn = [
  {
    q: 'এই ওয়েবসাইট থেকে বায়োডাটা ডাউনলোড করতে কি কোনো টাকা দিতে হবে?',
    a: 'না, একদমই নয়! FreeMarriageBiodataMaker.com সম্পূর্ণ ১০০% বিনামূল্যে সেবা প্রদান করে। অন্যান্য সাইটের মতো এখানে কোনো লুকানো চার্জ বা ₹৯৯-₹১৪৯ টাকা পেমেন্ট চাওয়ার ঝামেলা নেই।'
  },
  {
    q: 'ডাউনলোড করা PDF বা ছবিতে কি কোনো ওয়াটারমার্ক (Watermark) থাকবে?',
    a: 'না। কোনো বড় বা কদর্য ওয়াটারমার্ক থাকবে না। আপনার বায়োডাটাটি দেখতে হবে সম্পূর্ণ প্রফেশনাল ও মার্জিত, যাতে আপনি কোনো দ্বিধা ছাড়াই সরাসরি পাত্র/পাত্রীর পরিবার বা ঘটককে হোয়াটসঅ্যাপে পাঠাতে পারেন।'
  },
  {
    q: 'আমার আপলোড করা ছবি ও ব্যক্তিগত ফোন নম্বর কি এখানে নিরাপদ?',
    a: '১০০% নিরাপদ। আমাদের টুলটি সম্পূর্ণ আপনার নিজস্ব মোবাইল বা কম্পিউটারের ব্রাউজারে (Client-Side) কাজ করে। আপনার কোনো ছবি বা ফোন নম্বর আমাদের কোনো ডাটাবেজ বা সার্ভারে আপলোড বা সেভ করা হয় না।'
  },
  {
    q: 'WhatsApp-এ শেয়ার করার জন্য কোন ফরম্যাটে ডাউনলোড করা ভালো?',
    a: 'হোয়াটসঅ্যাপে শেয়ার করার জন্য আপনি সরাসরি "WhatsApp ইমেজ (HD)" বাটনে ক্লিক করতে পারেন অথবা "PDF ডাউনলোড" করে সরাসরি ডকুমেন্ট হিসেবে পাঠাতে পারেন।'
  },
  {
    q: 'একটি আদর্শ বিয়ের বায়োডাটায় কী কী তথ্য থাকা জরুরি?',
    a: 'ব্যক্তিগত তথ্য (নাম, জন্ম তারিখ, উচ্চতা, গায়ের রং), পারিবারিক বিবরণ (বাবা-মায়ের পেশা, ভাই-বোনের সংখ্যা), শিক্ষাগত যোগ্যতা ও পেশা (চাকরির পদবী ও আয়), এবং যোগাযোগের নম্বর ও ঠিকানা থাকা আবশ্যক।'
  }
];

const faqs = lang === 'bn' ? faqsBn : faqsEn;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map(f => ({
    '@type': 'Question',
    'name': f.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.a
    }
  }))
};
---

<section class="bg-white rounded-2xl shadow-lg border border-slate-200/80 p-6 sm:p-8">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <div class="max-w-2xl mx-auto text-center mb-8">
    <span class="text-xs font-bold text-rose-700 bg-rose-50 px-3 py-1 rounded-full uppercase tracking-wider">
      {lang === 'bn' ? 'প্রশ্নোত্তর' : 'FREQUENTLY ASKED QUESTIONS'}
    </span>
    <h3 class="text-2xl sm:text-3xl font-black text-slate-800 font-serif mt-2">
      {lang === 'bn' ? 'ম্যারেজ বায়োডাটা সংক্রান্ত সাধারণ প্রশ্নোত্তর (FAQ)' : 'Marriage Biodata Maker FAQs'}
    </h3>
    <p class="text-slate-500 text-sm mt-1">
      {lang === 'bn' ? 'বিনামূল্যে বায়োডাটা তৈরি ও ব্যবহারের নিয়মাবলী' : 'Common questions about creating and downloading free matrimonial biodatas'}
    </p>
  </div>

  <div class="space-y-4 max-w-3xl mx-auto">
    {faqs.map((faq, i) => (
      <details class="group bg-slate-50 rounded-xl border border-slate-200 p-4 transition-all duration-200 open:bg-rose-50/40 open:border-rose-300">
        <summary class="font-bold text-slate-800 flex items-center justify-between cursor-pointer list-none text-base select-none">
          <span>{i + 1}. {faq.q}</span>
          <span class="text-rose-700 font-bold ml-2 transition-transform duration-200 group-open:rotate-180">
            ↓
          </span>
        </summary>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed pl-4 border-l-2 border-rose-300">
          {faq.a}
        </p>
      </details>
    ))}
  </div>
</section>
