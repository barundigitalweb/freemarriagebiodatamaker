---
// Visual Gallery showcasing the 5 Indian Wedding Themes with Interactive One-Click Activation
import { BIODATA_TEMPLATES, type TemplateId } from '../lib/biodata-types';
import { Palette, Check, Sparkles } from 'lucide-react';

interface Props {
  lang?: 'en' | 'bn';
  formatType?: 'general' | 'hindu' | 'bengali' | 'marathi' | 'muslim';
}

const { lang = 'en', formatType = 'general' } = Astro.props;
const isMuslim = formatType === 'muslim';

const displayedTemplates = BIODATA_TEMPLATES.filter((tmpl) => {
  if (isMuslim) {
    return tmpl.id !== 'saffron-gold' && tmpl.id !== 'temple-gold';
  }
  return tmpl.id !== 'emerald-divine' && tmpl.id !== 'sapphire-noor';
});

const content = {
  en: {
    badge: 'PREMIUM THEMES',
    title: 'Royal Indian Marriage Biodata Templates',
    subtitle: 'Curated cultural palettes designed for all communities — click any template to apply it instantly',
    a4: 'A4 Print Ready',
    use: 'Use Template →'
  },
  bn: {
    badge: 'প্রিমিয়াম কালেকশন',
    title: 'রাজকীয় ভারতীয় বিবাহ বায়োডাটা টেমপ্লেট',
    subtitle: 'সব ধর্মের ও রুচির জন্য বিশেষভাবে তৈরি প্রিমিয়াম কালার থিম—যেকোনো টেমপ্লেটে ক্লিক করে তাৎক্ষণিকভাবে ব্যবহার করুন',
    a4: 'A4 Print Ready',
    use: 'ব্যবহার করুন →'
  }
}[lang];
---

<section id="template-gallery" class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/80 shadow-lg space-y-6">
  <div class="text-center max-w-2xl mx-auto space-y-2">
    <span class="text-xs font-bold text-rose-700 bg-rose-50 px-3 py-1 rounded-full uppercase tracking-wider">
      {content.badge}
    </span>
    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-serif">
      {content.title}
    </h3>
    <p class="text-slate-500 text-sm">
      {content.subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
    {displayedTemplates.map((tmpl) => (
      <div
        data-template-id={tmpl.id}
        class="template-card group bg-slate-50 hover:bg-white rounded-2xl p-4 sm:p-5 border-2 border-slate-200 hover:border-rose-500 shadow-xs hover:shadow-xl transition-all duration-200 flex flex-col justify-between cursor-pointer relative"
