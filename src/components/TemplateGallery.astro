---
// Visual Gallery showcasing the 5 Indian Wedding Themes
import { BIODATA_TEMPLATES } from '../lib/biodata-types';
import { Palette, Check, Sparkles } from 'lucide-react';
---

<section class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/80 shadow-lg space-y-6">
  <div class="text-center max-w-2xl mx-auto space-y-2">
    <span class="text-xs font-bold text-rose-700 bg-rose-50 px-3 py-1 rounded-full uppercase tracking-wider">
      প্রিমিয়াম কালেকশন
    </span>
    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-serif">
      রাজকীয় ভারতীয় বিবাহ বায়োডাটা টেমপ্লেট
    </h3>
    <p class="text-slate-500 text-sm">
      সব ধর্মের ও রুচির জন্য বিশেষভাবে তৈরি প্রিমিয়াম কালার থিম—কোনো ওয়াটারমার্ক ছাড়াই সম্পূর্ণ বিনামূল্যে ডাউনলোডযোগ্য
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
    {BIODATA_TEMPLATES.map((tmpl) => (
      <div class="group bg-slate-50 hover:bg-white rounded-2xl p-5 border-2 border-slate-200 hover:border-rose-400 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800">
              {tmpl.badge}
            </span>
            <div class="flex items-center gap-1.5">
              <span class="w-4 h-4 rounded-full border border-black/10 shadow-xs" style={`background-color: ${tmpl.primaryColor}`}></span>
              <span class="w-4 h-4 rounded-full border border-black/10 shadow-xs" style={`background-color: ${tmpl.secondaryColor}`}></span>
            </div>
          </div>

          <h4 class="text-base font-bold text-slate-800 font-serif group-hover:text-rose-800 transition">
            {tmpl.name}
          </h4>

          <p class="text-xs text-slate-500 leading-relaxed">
            {tmpl.description}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs font-bold text-rose-700">
          <span>A4 Print Ready</span>
          <a href="/#builder" class="hover:underline flex items-center gap-1">
            ব্যবহার করুন →
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
