<script>
  function setupTemplateClickHandlers() {
    const cards = document.querySelectorAll('.template-card');
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const templateId = card.getAttribute('data-template-id');
        if (!templateId) return;

        // 1. Dispatch custom event for the active BiodataBuilder component on this page
        window.dispatchEvent(
          new CustomEvent('select-biodata-template', {
            detail: { templateId }
          })
        );

        // 2. Smoothly scroll up to the builder
        const builder = document.getElementById('builder');
        if (builder) {
          builder.scrollIntoView({ behavior: 'smooth' });
        } else {
          // If on a page without a builder, navigate to home with query param
          window.location.href = `/?template=${templateId}#builder`;
        }
      });
    });
  }

  // Run on initial page load
  setupTemplateClickHandlers();

  // Re-run if client-side navigation occurs
  document.addEventListener('astro:page-load', setupTemplateClickHandlers);
</script>
