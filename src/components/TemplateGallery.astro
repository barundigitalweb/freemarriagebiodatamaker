---
// Visual Gallery showcasing the 5 Indian Wedding Themes with Interactive One-Click Activation
import { BIODATA_TEMPLATES, type TemplateId } from '../lib/biodata-types';
import { Palette, Check, Sparkles } from 'lucide-react';

interface Props {
  lang?: 'en' | 'bn';
  formatType?: 'general' | 'hindu' | 'bengali' | 'marathi' | 'muslim';
}

const { lang = 'en', formatType = 'general' } = Astro.props;
const isMuslim = formatType === 'muslim';

const displayedTemplates = BIODATA_TEMPLATES.filter((tmpl) => {
  if (isMuslim) {
    return tmpl.id !== 'saffron-gold';
  }
  return tmpl.id !== 'emerald-divine';
});

const content = {
  en: {
    badge: 'PREMIUM THEMES',
    title: 'Royal Indian Marriage Biodata Templates',
    subtitle: 'Curated cultural palettes designed for all communities — click any template to apply it instantly',
    a4: 'A4 Print Ready',
    use: 'Use Template →'
  },
  bn: {
    badge: 'প্রিমিয়াম কালেকশন',
    title: 'রাজকীয় ভারতীয় বিবাহ বায়োডাটা টেমপ্লেট',
    subtitle: 'সব ধর্মের ও রুচির জন্য বিশেষভাবে তৈরি প্রিমিয়াম কালার থিম—যেকোনো টেমপ্লেটে ক্লিক করে তাৎক্ষণিকভাবে ব্যবহার করুন',
    a4: 'A4 Print Ready',
    use: 'ব্যবহার করুন →'
  }
}[lang];
---

<section id="template-gallery" class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/80 shadow-lg space-y-6">
  <div class="text-center max-w-2xl mx-auto space-y-2">
    <span class="text-xs font-bold text-rose-700 bg-rose-50 px-3 py-1 rounded-full uppercase tracking-wider">
      {content.badge}
    </span>
    <h3 class="text-2xl sm:text-3xl font-black text-slate-900 font-serif">
      {content.title}
    </h3>
    <p class="text-slate-500 text-sm">
      {content.subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
    {displayedTemplates.map((tmpl) => (
      <div
        data-template-id={tmpl.id}
        class="template-card group bg-slate-50 hover:bg-white rounded-2xl p-5 border-2 border-slate-200 hover:border-rose-500 shadow-xs hover:shadow-xl transition-all duration-200 flex flex-col justify-between cursor-pointer relative"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800">
              {tmpl.badge}
            </span>
            <div class="flex items-center gap-1.5">
              <span class="w-4 h-4 rounded-full border border-black/10 shadow-xs" style={`background-color: ${tmpl.primaryColor}`}></span>
              <span class="w-4 h-4 rounded-full border border-black/10 shadow-xs" style={`background-color: ${tmpl.secondaryColor}`}></span>
            </div>
          </div>

          <h4 class="text-base font-bold text-slate-800 font-serif group-hover:text-rose-800 transition">
            {tmpl.name}
          </h4>

          <p class="text-xs text-slate-500 leading-relaxed">
            {tmpl.description}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs font-bold text-rose-700">
          <span class="text-slate-400 font-medium">{content.a4}</span>
          <button
            type="button"
            data-template-id={tmpl.id}
            class="template-select-btn inline-flex items-center gap-1.5 bg-rose-50 group-hover:bg-rose-700 text-rose-700 group-hover:text-white px-3 py-1.5 rounded-lg font-bold text-xs transition-colors shadow-2xs cursor-pointer"
          >
            <span>{content.use}</span>
          </button>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  function setupTemplateClickHandlers() {
    const cards = document.querySelectorAll('.template-card');
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const templateId = card.getAttribute('data-template-id');
        if (!templateId) return;

        // 1. Dispatch custom event for the active BiodataBuilder component on this page
        window.dispatchEvent(
          new CustomEvent('select-biodata-template', {
            detail: { templateId }
          })
        );

        // 2. Smoothly scroll up to the builder
        const builder = document.getElementById('builder');
        if (builder) {
          builder.scrollIntoView({ behavior: 'smooth' });
        } else {
          // If on a page without a builder, navigate to home with query param
          window.location.href = `/?template=${templateId}#builder`;
        }
      });
    });
  }

  // Run on initial page load
  setupTemplateClickHandlers();

  // Re-run if client-side navigation occurs
  document.addEventListener('astro:page-load', setupTemplateClickHandlers);
</script>
