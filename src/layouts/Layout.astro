---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  noindex?: boolean;
  lang?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = 'Free Marriage Biodata Maker Online | 100% Free Matrimonial Biodata with Photo',
  description = '100% Free Online Marriage Biodata Maker with Photo. Create elegant Indian wedding biodatas in Bengali, Hindi, Marathi & English. Download HD PDF & Image without watermark or login.',
  canonical,
  keywords = 'free marriage biodata maker, marriage biodata format, biodata for marriage pdf download, marriage biodata with photo, bengali marriage biodata, marathi marriage biodata maker, hindu marriage biodata format, muslim nikah biodata format',
  noindex = false,
  lang = 'en',
  breadcrumbs
} = Astro.props;

const siteUrl = 'https://freemarriagebiodatamaker.com';
const cleanPath = Astro.url.pathname.replace(/\/$/, '') || '';
const canonicalUrl = canonical || (cleanPath ? `${siteUrl}${cleanPath}` : siteUrl);

const schemaGraph: any[] = [
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    'url': siteUrl,
    'name': 'FreeMarriageBiodataMaker.com',
    'description': description,
    'inLanguage': ['en-IN', 'hi-IN', 'bn-IN', 'mr-IN'],
    'publisher': {
      '@id': `${siteUrl}/#organization`
    }
  },
  {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    'name': 'FreeMarriageBiodataMaker.com',
    'url': siteUrl,
    'logo': {
      '@type': 'ImageObject',
      'url': `${siteUrl}/og-image.png`
    }
  },
  {
    '@type': 'WebApplication',
    '@id': `${siteUrl}/#app`,
    'name': 'Free Marriage Biodata Maker',
    'url': siteUrl,
    'applicationCategory': 'DesignApplication',
    'operatingSystem': 'All (Web, Android, iOS, Windows, macOS)',
    'browserRequirements': 'Requires JavaScript',
    'featureList': [
      '100% Free with zero hidden charges',
      'Zero watermark on exported PDF and Image',
      'Client-side 100% on-device data privacy',
      '11 Cultural templates including Velvet Maroon, Vedic Ivory, Temple Gold, Sindoor Crimson, and Nikah Special',
      'Instant print-ready A4 PDF & WhatsApp HD image export'
    ],
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'INR'
    }
  }
];

if (breadcrumbs && breadcrumbs.length > 0) {
  schemaGraph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': siteUrl
      },
      ...breadcrumbs.map((b, idx) => ({
        '@type': 'ListItem',
        'position': idx + 2,
        'name': b.name,
        'item': b.url.startsWith('http') ? b.url : `${siteUrl}${b.url.startsWith('/') ? '' : '/'}${b.url}`
      }))
    ]
  });
}

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth overflow-x-hidden w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google tag (gtag.js) - Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BTQ4C6CLTE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BTQ4C6CLTE');
    </script>

    <!-- Robots: Directives for Google & Search Crawlers -->
    {noindex ? (
      <>
        <meta name="robots" content="noindex, nofollow" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    ) : (
      <>
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
      </>
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="FreeMarriageBiodataMaker.com" />
    <meta property="og:image" content="https://freemarriagebiodatamaker.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Free Marriage Biodata Maker with Photo Online" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://freemarriagebiodatamaker.com/og-image.png" />

    <!-- Theme & Icons -->
    <meta name="theme-color" content="#881337" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Cinzel (Royal Serif) + Inter (Clean Sans) + Regional Script Serifs -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Noto+Serif+Bengali:wght@500;600;700;800&family=Noto+Serif+Devanagari:wght@500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet" />

    <style is:global>
      html, body {
        overflow-x: hidden;
        max-width: 100vw;
      }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
      .font-serif {
        font-family: 'Cinzel', 'Playfair Display', 'Noto Serif Bengali', 'Noto Serif Devanagari', 'Amiri', Georgia, serif;
      }
      /* Hide scrollbar for clean horizontal swipe on mobile */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      /* =========================================================
         DIRECT A4 BIODATA PRINT PREVIEW (Clean 1-Page Biodata Print)
         ========================================================= */
      @media print {
        @page {
          size: A4 portrait;
          margin: 4mm 6mm !important;
        }

        html, body {
          background: #ffffff !important;
          color: #000000 !important;
          margin: 0 !important;
          padding: 0 !important;
          overflow: visible !important;
          max-width: 100% !important;
          width: 100% !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
          color-adjust: exact !important;
        }

        /* Hide all website chrome, hero, footer, forms, ads, and galleries */
        header,
        footer,
        nav,
        aside,
        .no-print,
        #template-gallery,
        #builder-form-card,
        section:not(#builder),
        .lg\:hidden {
          display: none !important;
        }

        main {
          margin: 0 !important;
          padding: 0 !important;
          width: 100% !important;
          max-width: 100% !important;
          display: block !important;
        }

        /* Reset grid and container constraints so the preview sheet prints centered and full-width */
        .max-w-7xl,
        .grid,
        #builder,
        #builder-preview-card {
          display: block !important;
          width: 100% !important;
          max-width: 100% !important;
          margin: 0 auto !important;
          padding: 0 !important;
          border: 0 !important;
          box-shadow: none !important;
        }

        /* The Isolated Printable Biodata Sheet: Perfectly Fitted to Single A4 */
        #biodata-preview-sheet {
          display: block !important;
          width: 100% !important;
          max-width: 198mm !important;
          margin: 0 auto !important;
          padding: 4mm 6mm !important;
          box-shadow: none !important;
          border-width: 2px !important;
          page-break-inside: avoid !important;
          break-inside: avoid !important;
          page-break-after: avoid !important;
          break-after: avoid !important;
          page-break-before: avoid !important;
          break-before: avoid !important;
          -webkit-print-color-adjust: exact !important;
          print-color-adjust: exact !important;
          color-adjust: exact !important;
        }

        /* Compact vertical spacing when printing so standard biodatas fit cleanly on 1 single A4 page */
        #biodata-preview-sheet > * + * {
          margin-top: 1.6mm !important;
        }

        #biodata-preview-sheet .space-y-1 > * + * {
          margin-top: 0.6mm !important;
        }

        #biodata-preview-sheet .space-y-1\.5 > * + * {
          margin-top: 0.8mm !important;
        }

        #biodata-preview-sheet .py-0\.5 {
          padding-top: 0.15mm !important;
          padding-bottom: 0.15mm !important;
          line-height: 1.25 !important;
        }

        #biodata-preview-sheet .section-heading-container,
        #biodata-preview-sheet .section-title-container {
          padding-bottom: 0.8mm !important;
          margin-bottom: 1.2mm !important;
        }

        #biodata-preview-sheet .section-heading-text {
          padding-bottom: 0.4mm !important;
          line-height: 1.2 !important;
        }

        #biodata-preview-sheet .section-divider-line {
          margin-top: 1mm !important;
          margin-bottom: 1.4mm !important;
        }

        /* Photo sizing on print */
        #biodata-preview-sheet img {
          max-height: 28mm !important;
          object-fit: cover !important;
        }
      }
    </style>

    <!-- Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="bg-slate-100/60 text-slate-900 min-h-screen flex flex-col antialiased selection:bg-rose-700 selection:text-white overflow-x-hidden w-full max-w-full">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
