---
import Layout from '../layouts/Layout.astro';
import BiodataBuilder from '../components/BiodataBuilder';
import TemplateGallery from '../components/TemplateGallery.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="বাঙালি বিয়ের বায়োডাটা মেকার (Bengali Marriage Biodata Maker) | ১০০% ফ্রি PDF"
  description="বাঙালি পাত্র ও পাত্রীদের জন্য বিনামূল্যে আকর্ষণীয় বিয়ের বায়োডাটা তৈরি করুন। ছবি সহ রাজকীয় বাংলা ডিজাইনে A4 সাইজ PDF ও WhatsApp ইমেজ ডাউনলোড করুন।"
  keywords="bengali marriage biodata maker, bangla marriage biodata format, biyer biodata format in bengali, bengali biodata for marriage pdf free, patro patri biyer biodata, bengali matrimonial biodata with photo, bangla matrimony biodata download"
>
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-8 sm:space-y-10 w-full max-w-full overflow-hidden">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 bg-rose-100 text-rose-800 text-[11px] sm:text-xs font-bold px-3 py-1 rounded-full">
        বাঙালি পাত্র-পাত্রী স্পেশাল
      </div>
      <h1 class="text-2xl min-[360px]:text-3xl sm:text-5xl font-black text-slate-900 tracking-tight font-serif">
        বাঙালি <span class="text-rose-700">বিয়ের বায়োডাটা</span> মেকার
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        রাশি, গোত্র, শিক্ষাগত যোগ্যতা এবং পারিবারিক বিবরণ সহ পাত্র ও পাত্রীদের জন্য ঐতিহ্যবাহী ও মার্জিত ডিজাইনে বায়োডাটা তৈরি করুন সম্পূর্ণ বিনামূল্যে।
      </p>
    </div>

    <BiodataBuilder client:load formatType="bengali" initialLanguage="bn" />

    <section class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-md space-y-4">
      <h2 class="text-2xl font-black text-slate-900 font-serif">
        বাঙালি বিয়ের বায়োডাটায় কী কী বিবরণ থাকা আবশ্যক?
      </h2>
      <ul class="list-disc pl-5 space-y-2 text-sm text-slate-700">
        <li><strong>ব্যক্তিগত বিবরণ:</strong> পুরো নাম, জন্ম তারিখ, জন্ম সময়, জন্মস্থান, উচ্চতা এবং গায়ের রং।</li>
        <li><strong>কুলীন ও পারিবারিক বংশ পরিচয়:</strong> ধর্ম, জাত, কুলীন পদবী, গোত্র, রাশি ও নক্ষত্র।</li>
        <li><strong>শিক্ষাগত ও পেশাগত যোগ্যতা:</strong> মাধ্যমিক, উচ্চমাধ্যমিক বা স্নাতক/স্নাতকোত্তর ডিগ্রি, বর্তমান চাকরির পদ ও কর্মক্ষেত্রের ঠিকানা।</li>
        <li><strong>পারিবারিক বিবরণ:</strong> পিতা-মাতার পরিচয় ও আদি পৈতৃক নিবাস (যেমন মেদিনীপুর, বর্ধমান, ঢাকা ইত্যাদি)।</li>
      </ul>
    </section>

    <TemplateGallery lang="bn" formatType="bengali" />
    <FaqSection lang="bn" />
  </div>
</Layout>
