---
import Layout from '../layouts/Layout.astro';
import BiodataBuilder from '../components/BiodataBuilder';
import TemplateGallery from '../components/TemplateGallery.astro';
import FaqSection from '../components/FaqSection.astro';
import AdSlot from '../components/AdSlot.astro';
import { Sparkles, CheckCircle2 } from 'lucide-react';
---

<Layout
  title="Free Marriage Biodata Maker Online | 100% Free Matrimonial Biodata with Photo"
  description="Create & Download elegant Indian marriage biodatas in PDF & HD image format. 100% Free, no watermark, no sign-up. 11 Royal cultural templates including Velvet Maroon, Vedic Ivory & Temple Gold."
  keywords="free marriage biodata maker, marriage biodata format, biodata for marriage with photo, biodata format for marriage in word, biodata maker online free, matrimonial biodata format, indian marriage biodata maker, free marriage biodata download pdf without watermark"
>
  {/* Hero Header */}
  <section class="no-print relative pt-8 pb-7 sm:pt-14 sm:pb-12 bg-gradient-to-b from-rose-50/70 via-amber-50/40 to-slate-100/60 border-b border-rose-100/80 w-full max-w-full overflow-hidden">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 text-center space-y-3.5 sm:space-y-4">
      <div class="inline-flex items-center gap-1.5 sm:gap-2 bg-rose-100 border border-rose-300 text-rose-900 px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-[10px] min-[360px]:text-[11px] sm:text-sm font-bold shadow-xs max-w-full">
        <Sparkles class="w-3 h-3 sm:w-4 sm:h-4 text-rose-700 shrink-0" />
        <span class="hidden sm:inline">100% Free Forever • Zero Watermark • No Sign-up</span>
        <span class="sm:hidden whitespace-nowrap">100% Free • No Watermark • No Login</span>
      </div>

      <h1 class="text-2xl min-[360px]:text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight sm:leading-none font-serif">
        Free <span class="text-rose-700">Marriage Biodata</span> Maker
      </h1>

      <p class="max-w-3xl mx-auto text-slate-600 text-xs sm:text-lg leading-relaxed px-1">
        Create elegant, royal Indian matrimonial biodatas with photo in 2 minutes. Fill in your details and instantly download print-ready <strong>A4 PDF</strong> or <strong>WhatsApp HD Images</strong> without watermark or hidden fees.
      </p>

      {/* Trust Badges */}
      <div class="grid grid-cols-2 sm:flex sm:flex-wrap items-center justify-center gap-2 sm:gap-6 pt-1 sm:pt-2 text-[11px] min-[360px]:text-xs sm:text-sm text-slate-700 font-semibold max-w-md sm:max-w-none mx-auto">
        <div class="flex items-center gap-1 bg-white/70 sm:bg-transparent p-1.5 sm:p-0 rounded-lg border border-slate-200/50 sm:border-0 shadow-xs sm:shadow-none min-w-0">
          <CheckCircle2 class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-600 shrink-0" />
          <span class="truncate sm:overflow-visible">Always 100% Free</span>
        </div>
        <div class="flex items-center gap-1 bg-white/70 sm:bg-transparent p-1.5 sm:p-0 rounded-lg border border-slate-200/50 sm:border-0 shadow-xs sm:shadow-none min-w-0">
          <CheckCircle2 class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-600 shrink-0" />
          <span class="truncate sm:overflow-visible">Zero Watermark</span>
        </div>
        <div class="flex items-center gap-1 bg-white/70 sm:bg-transparent p-1.5 sm:p-0 rounded-lg border border-slate-200/50 sm:border-0 shadow-xs sm:shadow-none min-w-0">
          <CheckCircle2 class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-600 shrink-0" />
          <span class="truncate sm:overflow-visible">100% Privacy</span>
        </div>
        <div class="flex items-center gap-1 bg-white/70 sm:bg-transparent p-1.5 sm:p-0 rounded-lg border border-slate-200/50 sm:border-0 shadow-xs sm:shadow-none min-w-0">
          <CheckCircle2 class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-emerald-600 shrink-0" />
          <span class="truncate sm:overflow-visible">A4 PDF & Images</span>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-10 sm:space-y-12 w-full max-w-full overflow-hidden">
    {/* The Core Interactive Biodata Builder Application */}
    <section id="builder">
      <BiodataBuilder client:load initialLanguage="en" formatType="general" />
    </section>

    {/* Template Gallery Showcase */}
    <div class="no-print">
      <TemplateGallery lang="en" formatType="general" />
    </div>

    {/* Non-intrusive Ad/Sponsorship Placement */}
    <div class="no-print">
      <AdSlot format="horizontal" />
    </div>

    {/* In-depth Educational Articles for AdSense E-E-A-T and SEO Authority */}
    <section class="no-print bg-white rounded-2xl shadow-lg border border-slate-200/80 p-4 sm:p-10 space-y-6 sm:space-y-8 overflow-hidden w-full max-w-full">
      <div class="max-w-3xl">
        <span class="text-xs font-bold text-rose-700 bg-rose-50 px-3 py-1 rounded-full uppercase tracking-wider">
          Complete Guide
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 font-serif mt-2">
          How to Create a Perfect Marriage Biodata (Step-by-Step Guide)
        </h2>
        <p class="text-slate-500 text-sm mt-1">
          A well-formatted biodata creates the first and strongest positive impression on prospective brides, grooms, and their families.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-slate-700 text-sm leading-relaxed">
        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3">
          <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-800 font-bold flex items-center justify-center">
            1
          </div>
          <h3 class="font-bold text-slate-900 text-base">1. Personal & Physical Details</h3>
          <p class="text-xs text-slate-600">
            State your full name, accurate date of birth, birth time, place of birth, height, and complexion gracefully. Attach a recent, clean, smiling passport or portrait photograph with a neat background.
          </p>
        </div>

        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3">
          <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-800 font-bold flex items-center justify-center">
            2
          </div>
          <h3 class="font-bold text-slate-900 text-base">2. Education & Career Background</h3>
          <p class="text-xs text-slate-600">
            Highlight your highest degrees (e.g. B.Tech, MBA, MBBS, M.Sc) and institution names. Clearly mention your occupation, job designation, current employer, work location, and approximate annual income.
          </p>
        </div>

        <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3">
          <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-800 font-bold flex items-center justify-center">
            3
          </div>
          <h3 class="font-bold text-slate-900 text-base">3. Family Heritage & Contact Details</h3>
          <p class="text-xs text-slate-600">
            Mention parents' full names and occupations, brothers and sisters with their marital status, family values (moderate/traditional), ancestral native place, and active guardian contact phone numbers.
          </p>
        </div>
      </div>
    </section>

    {/* FAQ Section */}
    <div class="no-print">
      <FaqSection lang="en" />
    </div>
  </div>
</Layout>
