---
import Layout from '../layouts/Layout.astro';
import { Mail, Clock, MessageSquare } from 'lucide-react';
---

<Layout
  title="Contact Us | FreeMarriageBiodataMaker.com"
  description="Get in touch with the FreeMarriageBiodataMaker.com team. Reach out for template suggestions, feedback, or support."
>
  <div class="max-w-3xl mx-auto px-3 sm:px-6 lg:px-8 py-10 sm:py-12 space-y-8 sm:space-y-10 w-full max-w-full overflow-hidden">
    <div class="text-center space-y-3">
      <span class="text-xs font-bold text-rose-700 bg-rose-50 px-3 py-1 rounded-full uppercase">
        SUPPORT & FEEDBACK
      </span>
      <h1 class="text-2xl min-[360px]:text-3xl sm:text-4xl font-black text-slate-900 tracking-tight font-serif">
        Contact Us
      </h1>
      <p class="text-slate-600 text-xs sm:text-base">
        Have questions, suggestions for new cultural templates, or feedback? We’d love to hear from you.
      </p>
    </div>

    <div class="bg-white rounded-2xl p-4 sm:p-10 border border-slate-200/80 shadow-md space-y-6 sm:space-y-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex items-center gap-3">
          <div class="p-2.5 bg-rose-100 text-rose-800 rounded-lg">
            <Mail class="w-5 h-5" />
          </div>
          <div>
            <span class="text-xs text-slate-500 font-medium block">Support Email</span>
            <span class="text-sm font-bold text-slate-800">support@freemarriagebiodatamaker.com</span>
          </div>
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex items-center gap-3">
          <div class="p-2.5 bg-rose-100 text-rose-800 rounded-lg">
            <Clock class="w-5 h-5" />
          </div>
          <div>
            <span class="text-xs text-slate-500 font-medium block">Response Time</span>
            <span class="text-sm font-bold text-slate-800">Within 24 Hours</span>
          </div>
        </div>
      </div>

      <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you! Your message has been received.');">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Your Name</label>
          <input
            type="text"
            required
            placeholder="e.g. Rahul Sharma"
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm outline-none focus:border-rose-600 focus:bg-white"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Your Email</label>
          <input
            type="email"
            required
            placeholder="you@example.com"
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm outline-none focus:border-rose-600 focus:bg-white"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Subject</label>
          <input
            type="text"
            required
            placeholder="Template suggestion / Feedback / General enquiry"
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm outline-none focus:border-rose-600 focus:bg-white"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-1">Message</label>
          <textarea
            rows={4}
            required
            placeholder="Write your message here..."
            class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm outline-none focus:border-rose-600 focus:bg-white"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-rose-700 hover:bg-rose-800 text-white font-bold py-3 rounded-xl transition shadow-md"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</Layout>
