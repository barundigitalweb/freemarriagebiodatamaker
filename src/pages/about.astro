---
import Layout from '../layouts/Layout.astro';
import { Target, Heart, ShieldCheck, Sparkles } from 'lucide-react';
---

<Layout
  title="আমাদের সম্পর্কে (About Us) | FreeMarriageBiodataMaker.com"
  description="FreeMarriageBiodataMaker.com সম্পর্কে বিস্তারিত জানুন। আমাদের মিশন ও উদ্দেশ্য—সবার জন্য ১০০% বিনামূল্যে ও প্রিমিয়াম ম্যারেজ বায়োডাটা টুল তৈরি।"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center space-y-3">
      <span class="text-xs font-bold text-rose-700 bg-rose-50 px-3 py-1 rounded-full uppercase">
        আমাদের পরিচিতি
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight font-serif">
        FreeMarriageBiodataMaker.com সম্পর্কে
      </h1>
      <p class="text-slate-600 text-base max-w-2xl mx-auto">
        ভারতীয় বিয়ের বায়োডাটা তৈরির ক্ষেত্রে লুকানো চার্জ এবং প্রতারণার ইতি টানতেই আমাদের এই সম্পূর্ণ ফ্রি উদ্যোগ।
      </p>
    </div>

    <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/80 shadow-md space-y-8 text-slate-700 text-sm sm:text-base leading-relaxed">
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2 font-serif">
          <Target class="w-5 h-5 text-rose-600" />
          <span>আমাদের উদ্দেশ্য (Our Mission)</span>
        </h2>
        <p>
          ইন্টারনেটে অধিকাংশ বায়োডাটা মেকার ওয়েবসাইট নাম দেয় "Free", কিন্তু ইউজার যখন ১৫ মিনিট ধরে সব পারিবারিক তথ্য ও ছবি পূরণ করে ডাউনলোড করতে যায়, তখন ₹৯৯ থেকে ₹১৪৯ টাকা পেমেন্ট দাবি করে। 
        </p>
        <p>
          আমরা বিশ্বাস করি, নতুন জীবনের শুরুতে দুটি পরিবারের মিলনের এই গুরুত্বপূর্ণ প্রথম পদক্ষেপে কারো সাথে এমন বিভ্রান্তি তৈরি করা উচিত নয়। তাই <strong>FreeMarriageBiodataMaker.com</strong> একটি সম্পূর্ণ ১০০% বিনামূল্যে ব্যবহারযোগ্য অনলাইন প্ল্যাটফর্ম, যা কোনোদিন আপনার কাছে ১ টাকাও দাবি করবে না এবং কোনো বড় ওয়াটারমার্ক চাপিয়ে দেবে না।
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2 font-serif">
          <ShieldCheck class="w-5 h-5 text-emerald-600" />
          <span>১০০% অন-ডিভাইস প্রাইভেসি (Client-Side Privacy)</span>
        </h2>
        <p>
          অন্যান্য ওয়েবসাইট আপনার পাত্র বা পাত্রীর ছবি ও ফোন নম্বর তাদের কেন্দ্রীয় সার্ভারে সংরক্ষণ করে রাখে, যা ডাটা লিকের ঝুঁকিতে ফেলতে পারে। আমাদের টুলটি সম্পূর্ণ আপনার ফোনের বা কম্পিউটারের ব্রাউজারে কাজ করে। কোনো তথ্যই কোনো সার্ভারে আপলোড হয় না।
        </p>
      </section>
    </div>
  </div>
</Layout>
