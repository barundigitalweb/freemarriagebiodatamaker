---
import Layout from '../layouts/Layout.astro';
import { AlertCircle } from 'lucide-react';
---

<Layout
  title="অস্বীকৃতি (Disclaimer) | FreeMarriageBiodataMaker.com"
  description="FreeMarriageBiodataMaker.com-এর আইনি অস্বীকৃতি ও শর্তাবলী।"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center space-y-3">
      <div class="inline-flex p-3 bg-amber-100 text-amber-800 rounded-2xl mb-1">
        <AlertCircle class="w-8 h-8 text-amber-700" />
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight font-serif">
        অস্বীকৃতি (Disclaimer)
      </h1>
      <p class="text-slate-500 text-sm">গুরুত্বপূর্ণ নোটিশ</p>
    </div>

    <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/80 shadow-md space-y-6 text-slate-700 text-sm leading-relaxed">
      <div class="p-4 bg-amber-50 border-l-4 border-amber-500 rounded-r-xl text-amber-950 font-medium">
        <strong>ম্যাট্রিমনিয়াল নিরপেক্ষতা:</strong> FreeMarriageBiodataMaker.com কোনো ম্যাট্রিমনিয়াল ব্যুরো, ঘটক বা ম্যাচমেকিং এজেন্সি নয়। আমরা শুধুমাত্র একটি ডিজাইন টুল প্রদান করি যার মাধ্যমে ইউজাররা তাদের তথ্য দিয়ে একটি বায়োডাটা PDF বা ইমেজ তৈরি করতে পারেন।
      </div>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 font-serif">১. তথ্যের যথার্থতা যাচাই</h2>
        <p>
          যেকোনো বায়োডাটার ওপর ভিত্তি করে বৈবাহিক সম্পর্ক স্থাপন বা বিয়ের আলোচনায় এগিয়ে যাওয়ার আগে পাত্র বা পাত্রীর পরিবারের ব্যাকগ্রাউন্ড, চারিত্রিক তথ্য ও শিক্ষাগত সনদপত্র নিজস্ব দায়িত্বে যাচাই করে নেওয়ার অনুরোধ করা হচ্ছে।
        </p>
      </section>
    </div>
  </div>
</Layout>
