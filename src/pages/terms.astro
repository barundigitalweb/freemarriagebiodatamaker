---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="ব্যবহারের শর্তাবলী (Terms of Service) | FreeMarriageBiodataMaker.com"
  description="FreeMarriageBiodataMaker.com ব্যবহারের নিয়ম ও শর্তাবলী।"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight font-serif">
        ব্যবহারের শর্তাবলী (Terms of Service)
      </h1>
      <p class="text-slate-500 text-sm">কার্যকরী তারিখ: নভেম্বর ২০২৬</p>
    </div>

    <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/80 shadow-md space-y-6 text-slate-700 text-sm leading-relaxed">
      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 font-serif">১. শর্তাবলীর স্বীকৃতি</h2>
        <p>
          FreeMarriageBiodataMaker.com ব্যবহার করে আপনি এই শর্তাবলীর সাথে সম্পূর্ণ সম্মত হচ্ছেন। আপনি এই শর্তাবলীতে একমত না হলে আমাদের ওয়েবসাইট ব্যবহার বন্ধ রাখুন।
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 font-serif">২. সেবার প্রকৃতি</h2>
        <p>
          আমাদের ওয়েবসাইটটি শুধুমাত্র ব্যক্তিগত বৈবাহিক বায়োডাটা ডকুমেন্ট তৈরির উদ্দেশ্যে সরবরাহ করা হয়েছে। এটি কোনো ম্যাট্রিমোনিয়াল ঘটকালি বা ডেটিং সেবা নয়।
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900 font-serif">৩. ব্যবহারকারীর তথ্যের সত্যতা</h2>
        <p>
          বায়োডাটায় প্রদত্ত তথ্যের সত্যতার সম্পূর্ণ দায় ব্যবহারকারীর। অসত্য বা বিভ্রান্তিকর কোনো তথ্য প্রদানের জন্য আমাদের প্ল্যাটফর্ম দায়ী থাকবে না।
        </p>
      </section>
    </div>
  </div>
</Layout>
